#!/usr/bin/env bash

tool="${1:-CLI}"
subtitle="${2:-stopped}"
message="${3:-}"
sound="${4:-default}"

if command -v terminal-notifier >/dev/null 2>&1; then
    args=(-title "$tool" -subtitle "$subtitle" -message "$message")
    if [ "$sound" != "none" ]; then
        args+=(-sound "$sound")
    fi
    if terminal-notifier "${args[@]}" >/dev/null 2>&1; then
        exit 0
    fi
fi

if [ -x /usr/bin/osascript ]; then
    /usr/bin/osascript - "$tool" "$subtitle" "$message" <<'APPLESCRIPT'
on run argv
  display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv)
end run
APPLESCRIPT
    exit $?
fi

echo "No macOS notification backend is available." >&2
exit 1
